#!/usr/bin/env bash
# cadbury: your coding agent in this terminal + a floating voice cat that follows it.
#
#   cadbury [dir] [claude args…]      Claude Code (your subscription), default
#   cadbury --opencode [dir]          opencode instead
#   CADBURY_DEBUG=1 cadbury             pet/bridge logs in ~/.cache/cadbury/pet.log
set -uo pipefail
# resolve symlinks portably (macOS has no `readlink -f` on older versions)
SRC="$0"; while [ -L "$SRC" ]; do L="$(readlink "$SRC")"; case "$L" in /*) SRC="$L" ;; *) SRC="$(dirname "$SRC")/$L" ;; esac; done
ROOT="$(cd "$(dirname "$SRC")/.." && pwd)"
abspath() { (cd "$1" && pwd -P); }
set -a; [ -f "$ROOT/.env" ] && . "$ROOT/.env"; set +a
# Legacy: settings were called MOCHI_* before the rename; use them when the CADBURY_* one isn't set.
for v in $(compgen -e | grep '^MOCHI_'); do n="CADBURY_${v#MOCHI_}"; [ -z "${!n+x}" ] && export "$n=${!v}"; done

HARNESS="${CADBURY_HARNESS:-claude}"
case "${1:-}" in
  --opencode) HARNESS=opencode; shift ;;
  --claude)   HARNESS=claude; shift ;;
esac
DIR="$PWD"
if [ $# -gt 0 ] && [ -d "$1" ]; then DIR="$(abspath "$1")"; shift; fi
export DEFAULT_PROJECT="$DIR" CADBURY_HARNESS="$HARNESS"

PORT="${CADBURY_PORT:-8787}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/cadbury"; mkdir -p "$CACHE"
LOG="$CACHE/pet.log"
up() { curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; }
json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }

# ---- the cat (Electron → bridge) ----
PET_PGID=""
if ! up; then
  if [ -x "$ROOT/node_modules/.bin/electron" ]; then ELECTRON="$ROOT/node_modules/.bin/electron"
  elif command -v electron >/dev/null; then ELECTRON=electron
  else echo "Electron not found. Run ./install.sh (or: bun install) in $ROOT"; exit 1; fi
  command -v bun >/dev/null || { echo "Bun not found: https://bun.sh"; exit 1; }
  FLAGS=(); [ -z "${CADBURY_DEBUG:-}" ] && FLAGS+=(--log-level=3)
  if [ "$(uname)" = Linux ]; then
    # Wayland desktops ignore always-on-top for native Wayland windows → run under XWayland.
    # It must be chosen on the command line; setting it from main.js is too late.
    FLAGS+=(--ozone-platform=x11); export ELECTRON_OZONE_PLATFORM_HINT=x11
  fi
  set -m  # own process group, so we can stop the cat (and its bridge) together
  "$ELECTRON" ${FLAGS[@]+"${FLAGS[@]}"} "$ROOT/desktop/main.js" >"$LOG" 2>&1 < /dev/null &
  PET_PGID=$!
  set +m
  printf '🐱 waking Cadbury up'
  for _ in $(seq 1 80); do up && break; printf '.'; sleep 0.25; done; echo
  up || { echo "Cadbury failed to start, see $LOG"; exit 1; }
fi
cleanup() { [ -n "$PET_PGID" ] && kill -- -"$PET_PGID" 2>/dev/null; }

register() { # $1 = tmux socket, $2 = tmux pane
  curl -sf -XPOST "http://127.0.0.1:$PORT/api/context" -H 'content-type: application/json' \
    -d "{\"directory\":$(json_str "$DIR"),\"harness\":\"$HARNESS\",\"tmux\":$(json_str "${2:-}"),\"tmuxSocket\":$(json_str "${1:-}")}" >/dev/null
}

# ---- opencode ----
if [ "$HARNESS" = opencode ]; then
  register
  trap cleanup EXIT INT TERM
  opencode attach "http://127.0.0.1:${OPENCODE_PORT:-4096}" --dir "$DIR" "$@"
  exit
fi

# ---- Claude Code ----
# Hooks are passed with --settings, so they only apply to sessions started by cadbury.
HOOKS="$CACHE/claude-hooks.json"
H="$ROOT/bin/cadbury-hook"
hook() { printf '"%s":[{"hooks":[{"type":"command","command":"%s %s","timeout":5}]}]' "$1" "$H" "$1"; }
printf '{"hooks":{%s,%s,%s,%s,%s,%s,%s,%s}}\n' \
  "$(hook SessionStart)" "$(hook UserPromptSubmit)" "$(hook PreToolUse)" "$(hook PostToolUse)" \
  "$(hook PermissionRequest)" "$(hook Notification)" "$(hook Stop)" "$(hook SessionEnd)" > "$HOOKS"

if [ -n "${TMUX:-}" ]; then
  # Already inside tmux: run Claude Code right here in this pane.
  register "${TMUX%%,*}" "$TMUX_PANE"
  trap cleanup EXIT INT TERM
  claude --settings "$HOOKS" "$@"
  exit
fi

# Otherwise: a private tmux server (-L cadbury) so the cat can type into Claude Code.
command -v tmux >/dev/null || { echo "tmux is required for Claude Code mode (the cat types into Claude through it). Install tmux, or use: cadbury --opencode"; cleanup; exit 1; }
command -v claude >/dev/null || { echo "Claude Code CLI not found: https://claude.com/claude-code"; cleanup; exit 1; }
T=(tmux -L cadbury)
NAME="cadbury-$(basename "$DIR" | tr -c 'a-zA-Z0-9_\n-' '-')-$$"
CMD=$(printf '%q ' claude --settings "$HOOKS" "$@")
PANE=$("${T[@]}" new-session -d -s "$NAME" -c "$DIR" -x "$(tput cols 2>/dev/null || echo 120)" -y "$(tput lines 2>/dev/null || echo 40)" -P -F '#{pane_id}' "$CMD")
"${T[@]}" set -s escape-time 0 \; set -t "$NAME" status off \; set -t "$NAME" mouse on \
  \; set -as terminal-features ',*:RGB' >/dev/null 2>&1
SOCK=$("${T[@]}" display -p -t "$NAME" '#{socket_path}')
register "$SOCK" "$PANE"
"${T[@]}" attach -t "$NAME"

if "${T[@]}" has-session -t "$NAME" 2>/dev/null; then
  echo "🐱 Detached. Claude Code is still running; come back with:  tmux -L cadbury attach -t $NAME"
else
  cleanup
fi
