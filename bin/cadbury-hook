#!/bin/sh
# Claude Code hook → Cadbury bridge. Never blocks or fails Claude: always exits 0, prints nothing.
# The tmux pane (set by tmux for everything running in it) tells the bridge which Claude session this is.
curl -s --max-time 2 -X POST -H 'content-type: application/json' \
  -H "x-cadbury-pane: ${TMUX_PANE:-}" -H "x-cadbury-socket: ${TMUX%%,*}" --data-binary @- \
  "http://127.0.0.1:${CADBURY_PORT:-${MOCHI_PORT:-8787}}/api/claude-hook?event=$1" >/dev/null 2>&1
exit 0
