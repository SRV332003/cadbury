#!/usr/bin/env bash
# cadbury-mac-app: build Cadbury.app so you can start Cadbury like any other Mac app
# (Launchpad, Spotlight, Dock, Finder).
#
#   bin/cadbury-mac-app              installs into /Applications (or ~/Applications if not writable)
#   bin/cadbury-mac-app ~/Desktop    installs somewhere else
#
# Opening the app asks which project folder to work on (it remembers the last one),
# then opens Terminal and runs `cadbury <folder>` there, exactly as if you typed it.
# The app points at this checkout, so run this again if you move the cadbury folder.
set -euo pipefail
[ "$(uname)" = Darwin ] || { echo "Cadbury.app is for macOS only."; exit 1; }

SRC="$0"; while [ -L "$SRC" ]; do L="$(readlink "$SRC")"; case "$L" in /*) SRC="$L" ;; *) SRC="$(dirname "$SRC")/$L" ;; esac; done
ROOT="${CADBURY_ROOT:-$(cd "$(dirname "$SRC")/.." && pwd)}"
[ -x "$ROOT/bin/cadbury" ] || { echo "No bin/cadbury in $ROOT"; exit 1; }

if [ $# -gt 0 ]; then DEST="$1"
elif [ -w /Applications ]; then DEST=/Applications
else DEST="$HOME/Applications"; fi
mkdir -p "$DEST"
APP="$DEST/Cadbury.app"
VERSION="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ROOT/package.json" | head -1)"

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

# ---- Info.plist ----
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Cadbury</string>
  <key>CFBundleDisplayName</key><string>Cadbury</string>
  <key>CFBundleIdentifier</key><string>dev.cadbury.launcher</string>
  <key>CFBundleExecutable</key><string>Cadbury</string>
  <key>CFBundleIconFile</key><string>Cadbury</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${VERSION:-0.0.0}</string>
  <key>CFBundleVersion</key><string>${VERSION:-0.0.0}</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Cadbury opens Terminal to start your coding agent.</string>
</dict>
</plist>
PLIST

# ---- the launcher ----
# printf %q bakes the checkout path in safely, even with spaces or quotes in it.
{
  echo '#!/bin/bash'
  printf 'ROOT=%q\n' "$ROOT"
  cat <<'LAUNCHER'
CONF="$HOME/.config/cadbury"; LAST="$CONF/app-last-folder"
last="$(cat "$LAST" 2>/dev/null || true)"; [ -d "$last" ] || last="$HOME"

# Ask for the project folder. Cancel = quit quietly.
dir="$(osascript - "$last" <<'AS'
on run argv
  tell me to activate
  POSIX path of (choose folder with prompt "Which project should Cadbury work on?" default location (POSIX file (item 1 of argv)))
end run
AS
)" || exit 0
dir="${dir%/}"; [ -n "$dir" ] || dir="/"
mkdir -p "$CONF" && printf '%s\n' "$dir" > "$LAST"

# Run cadbury in a new Terminal window (it needs a terminal: Claude Code lives there).
osascript - "$ROOT/bin/cadbury" "$dir" <<'AS'
on run argv
  tell application "Terminal"
    activate
    do script (quoted form of (item 1 of argv) & " " & quoted form of (item 2 of argv))
  end tell
end run
AS
LAUNCHER
} > "$APP/Contents/MacOS/Cadbury"
chmod +x "$APP/Contents/MacOS/Cadbury"

# ---- icon (web/icon.svg → .icns) ----
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
BASE="$TMP/icon-1024.png"
if qlmanage -t -s 1024 -o "$TMP" "$ROOT/web/icon.svg" >/dev/null 2>&1 && [ -f "$TMP/icon.svg.png" ]; then
  mv "$TMP/icon.svg.png" "$BASE"
else
  sips -z 1024 1024 "$ROOT/web/icon.png" --out "$BASE" >/dev/null   # blurry fallback
fi
SET="$TMP/Cadbury.iconset"; mkdir -p "$SET"
for s in 16 32 128 256 512; do
  sips -z $s $s "$BASE" --out "$SET/icon_${s}x${s}.png" >/dev/null
  sips -z $((s*2)) $((s*2)) "$BASE" --out "$SET/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$SET" -o "$APP/Contents/Resources/Cadbury.icns"

# Ad-hoc signature: lets macOS remember the "control Terminal" permission between launches.
codesign --force --sign - "$APP" >/dev/null 2>&1 || true
# Tell Launchpad/Spotlight about it now instead of whenever they next look.
LSREG=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
[ -x "$LSREG" ] && "$LSREG" -f "$APP" >/dev/null 2>&1 || true
touch "$APP"

echo "🐱 Installed $APP"
echo "   Open it from Launchpad, Spotlight (⌘Space → Cadbury) or drag it to the Dock."
echo "   It runs: $ROOT/bin/cadbury <folder you pick>"
