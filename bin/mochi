#!/usr/bin/env bash
# Legacy name: `mochi` was renamed to `cadbury`. Kept so old ~/.local/bin/mochi links and habits keep working.
SRC="$0"; while [ -L "$SRC" ]; do L="$(readlink "$SRC")"; case "$L" in /*) SRC="$L" ;; *) SRC="$(dirname "$SRC")/$L" ;; esac; done
exec "$(cd "$(dirname "$SRC")" && pwd)/cadbury" "$@"
