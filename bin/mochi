#!/usr/bin/env bash
# mochi: your coding agent in this terminal + a floating voice cat that follows it.
#
#   mochi [dir] [claude args…]      Claude Code (your subscription), default
#   mochi --opencode [dir]          opencode instead
#   MOCHI_DEBUG=1 mochi             pet/bridge logs in ~/.cache/mochi/pet.log
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
set -a; [ -f "$ROOT/.env" ] && . "$ROOT/.env"; set +a

HARNESS="${MOCHI_HARNESS:-claude}"
case "${1:-}" in
  --opencode) HARNESS=opencode; shift ;;
  --claude)   HARNESS=claude; shift ;;
esac
DIR="$PWD"
if [ $# -gt 0 ] && [ -d "$1" ]; then DIR="$(readlink -f "$1")"; shift; fi
export DEFAULT_PROJECT="$DIR" MOCHI_HARNESS="$HARNESS"

PORT="${MOCHI_PORT:-8787}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/mochi"; mkdir -p "$CACHE"
LOG="$CACHE/pet.log"
up() { curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; }
json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }

# ---- the cat (Electron → bridge) ----
PET_PGID=""
if ! up; then
  # The display backend must be picked on the command line; main.js is too late.
  FLAGS=(--ozone-platform=x11 --log-level=3); [ -n "${MOCHI_DEBUG:-}" ] && FLAGS=(--ozone-platform=x11)
  ELECTRON_OZONE_PLATFORM_HINT=x11 setsid electron "${FLAGS[@]}" "$ROOT/desktop/main.js" >"$LOG" 2>&1 < /dev/null &
  PET_PGID=$!
  printf '🐱 waking Mochi up'
  for _ in $(seq 1 80); do up && break; printf '.'; sleep 0.25; done; echo
  up || { echo "Mochi failed to start, see $LOG"; exit 1; }
fi
cleanup() { [ -n "$PET_PGID" ] && kill -- -"$PET_PGID" 2>/dev/null; }

register() { # $1 = tmux socket, $2 = tmux pane
  curl -sf -XPOST "http://127.0.0.1:$PORT/api/context" -H 'content-type: application/json' \
    -d "{\"directory\":$(json_str "$DIR"),\"harness\":\"$HARNESS\",\"tmux\":$(json_str "${2:-}"),\"tmuxSocket\":$(json_str "${1:-}")}" >/dev/null
}

# ---- opencode ----
if [ "$HARNESS" = opencode ]; then
  register
  trap cleanup EXIT INT TERM
  opencode attach "http://127.0.0.1:${OPENCODE_PORT:-4096}" --dir "$DIR" "$@"
  exit
fi

# ---- Claude Code ----
# Hooks are passed with --settings, so they only apply to sessions started by mochi.
HOOKS="$CACHE/claude-hooks.json"
H="$ROOT/bin/mochi-hook"
hook() { printf '"%s":[{"hooks":[{"type":"command","command":"%s %s","timeout":5}]}]' "$1" "$H" "$1"; }
printf '{"hooks":{%s,%s,%s,%s,%s,%s,%s,%s}}\n' \
  "$(hook SessionStart)" "$(hook UserPromptSubmit)" "$(hook PreToolUse)" "$(hook PostToolUse)" \
  "$(hook PermissionRequest)" "$(hook Notification)" "$(hook Stop)" "$(hook SessionEnd)" > "$HOOKS"

if [ -n "${TMUX:-}" ]; then
  # Already inside tmux: run Claude Code right here in this pane.
  register "${TMUX%%,*}" "$TMUX_PANE"
  trap cleanup EXIT INT TERM
  claude --settings "$HOOKS" "$@"
  exit
fi

# Otherwise: a private tmux server (-L mochi) so the cat can type into Claude Code.
T=(tmux -L mochi)
NAME="mochi-$(basename "$DIR" | tr -c 'a-zA-Z0-9_\n-' '-')-$$"
CMD=$(printf '%q ' claude --settings "$HOOKS" "$@")
PANE=$("${T[@]}" new-session -d -s "$NAME" -c "$DIR" -x "$(tput cols)" -y "$(tput lines)" -P -F '#{pane_id}' "$CMD")
"${T[@]}" set -s escape-time 0 \; set -t "$NAME" status off \; set -t "$NAME" mouse on \
  \; set -as terminal-features ',*:RGB' >/dev/null 2>&1
SOCK=$("${T[@]}" display -p -t "$NAME" '#{socket_path}')
register "$SOCK" "$PANE"
"${T[@]}" attach -t "$NAME"

if "${T[@]}" has-session -t "$NAME" 2>/dev/null; then
  echo "🐱 Detached. Claude Code is still running; come back with:  tmux -L mochi attach -t $NAME"
else
  cleanup
fi
