# Required for voice (OpenAI Realtime). Stays on this machine; the browser only gets a 10-min ephemeral token.
OPENAI_API_KEY=sk-...
# Optional
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
OPENCODE_PORT=4096
MOCHI_PORT=8787
# Project the cat starts in (default: where you launch it)
DEFAULT_PROJECT=/home/sudokamal/Storage/projects
# Folders whose subfolders count as "projects" for voice switching
PROJECT_ROOTS=/home/sudokamal/Storage/projects,/home/sudokamal/Storage/Projects,/home/sudokamal/Storage
# Only this tailnet user may use the phone remote (via tailscale serve)
ALLOWED_TS_USER=sudokamal@
MOCHI_HOTKEY=Control+Alt+Space
MOCHI_TERMINAL=kgx
# Voice: gemini (free tier via AI Studio key) or openai
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Leda
# set to 1 if the cat hears itself talking (mutes mic while it speaks; no barge-in)
MOCHI_HALF_DUPLEX=
# Which coding agent `mochi` launches: claude (Claude Code, default) or opencode
MOCHI_HARNESS=claude
# Pet size (1 = default, 0.5 = half, 2 = double). Right-click → Size overrides this.
MOCHI_SCALE=1
# Language the cat speaks by default (saying "talk to me in English" changes and remembers it)
MOCHI_LANGUAGE=Hinglish
