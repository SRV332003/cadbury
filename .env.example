# ─── Mochi settings ─── copy to .env (install.sh does this). Everything except one voice key is optional.

# Voice: "gemini" (free tier, key from https://aistudio.google.com/apikey) or "openai" (paid Realtime API).
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Leda
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# Which coding agent `mochi` starts: claude (Claude Code) or opencode.  `mochi --opencode` also works.
MOCHI_HARNESS=claude

# Language the cat speaks, e.g. Hinglish (casual Hindi-English mix), Hindi, English, Spanish.
# Empty = match whatever you speak. Saying "talk to me in X" changes and remembers it.
MOCHI_LANGUAGE=Hinglish

# Pet size (1 = normal, 0.5 = half, 2 = double). Right-click → Size overrides this.
MOCHI_SCALE=1

# Interruptions / turn-taking (tune if needed)
#   MOCHI_BARGE_THRESHOLD: mic level that counts as you talking over the cat (lower = easier to interrupt; default 0.06)
#   MOCHI_SILENCE_MS: how long you must pause before the cat replies (default 800)
#   MOCHI_HALF_DUPLEX=1: mute the mic while the cat speaks (use if it hears itself; disables interrupting)
MOCHI_BARGE_THRESHOLD=
MOCHI_SILENCE_MS=
MOCHI_HALF_DUPLEX=

# Ports
MOCHI_PORT=8787
OPENCODE_PORT=4096

# opencode mode: folders whose subfolders count as projects for "switch to project X" (comma-separated)
PROJECT_ROOTS=

# Phone remote over `tailscale serve`: only allow this tailnet login (e.g. you@github). Empty = whole tailnet.
ALLOWED_TS_USER=

# Terminal used by "Open opencode TUI here" (auto-detected if empty), and global hotkey on X11/macOS
MOCHI_TERMINAL=
MOCHI_HOTKEY=Control+Alt+Space
