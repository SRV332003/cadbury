# ─── Cadbury settings ─── copy to .env (install.sh does this). Everything except one voice key is optional.

# Voice: "gemini" (free tier, key from https://aistudio.google.com/apikey) or "openai" (paid Realtime API).
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Leda
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# Which coding agent `cadbury` starts: claude (Claude Code) or opencode.  `cadbury --opencode` also works.
CADBURY_HARNESS=claude

# Language the cat speaks, e.g. Hinglish (casual Hindi-English mix), Hindi, English, Spanish.
# Unset = Hinglish. Empty = match whatever you speak. Saying "talk to me in X" changes and remembers it.
CADBURY_LANGUAGE=Hinglish

# Pet size (1 = normal, 0.5 = half, 2 = double). Right-click → Size overrides this.
CADBURY_SCALE=1

# Interruptions / turn-taking (tune if needed)
#   CADBURY_BARGE_THRESHOLD: mic level that counts as you talking over the cat (lower = easier to interrupt; default 0.06)
#   CADBURY_SILENCE_MS: how long you must pause before the cat replies (default 800)
#   CADBURY_HALF_DUPLEX=1: mute the mic while the cat speaks (use if it hears itself; disables interrupting)
CADBURY_BARGE_THRESHOLD=
CADBURY_SILENCE_MS=
CADBURY_HALF_DUPLEX=

# Ports
CADBURY_PORT=8787
OPENCODE_PORT=4096

# opencode mode: folders whose subfolders count as projects for "switch to project X" (comma-separated)
PROJECT_ROOTS=

# Phone remote over `tailscale serve`: only allow this tailnet login (e.g. you@github). Empty = whole tailnet.
ALLOWED_TS_USER=

# Terminal used by "Open opencode TUI here" (auto-detected if empty), and global hotkey on X11/macOS
CADBURY_TERMINAL=
CADBURY_HOTKEY=Control+Alt+Space

# ─── Memory (see docs/MEMORY.md) ───
# Cadbury always keeps what you ask it to remember. To also let it notice things on its own,
# give it a helper model. Two easy options:
#   A) Reuse your Gemini key (nothing to install; the conversation is reviewed by Google):
#        CADBURY_MEMORY_MODEL=gemini-flash-lite-latest
#   B) Fully local with Ollama (brew install ollama; ollama pull qwen3:4b):
#        CADBURY_MEMORY_LLM_URL=http://127.0.0.1:11434/v1
#        CADBURY_MEMORY_MODEL=qwen3:4b
# Any other OpenAI-compatible server works too (LM Studio, llama.cpp, or a hosted API with CADBURY_MEMORY_LLM_KEY).
CADBURY_MEMORY_MODEL=
CADBURY_MEMORY_LLM_URL=
CADBURY_MEMORY_LLM_KEY=
# How many things you say before it looks back for things worth remembering.
# (It also looks back when you go quiet for 5 minutes.)
CADBURY_MEMORY_REVIEW_TURNS=10
